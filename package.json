{
  "name": "nizam-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run emoji:check && npm run i18n:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "register": "tsx scripts/register-commands.ts",
    "doctor": "tsx scripts/doctor.ts",
    "emoji:check": "tsx scripts/emoji-guard.ts",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "better-sqlite3": "^13.0.3",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lru-cache": "^11.5.3",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
